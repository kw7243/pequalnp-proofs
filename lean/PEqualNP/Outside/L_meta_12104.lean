namespace Oracle12105
open PEqualNP.CircuitLowerBounds Prefix12105 Block12105 FastBlock12105
def ordinarySet (pre : List Gate) : Finset ℕ :=
  (Finset.range 6).filter fun w =>
    w != 3 && w != 4 && pre.any fun g => g.inputs.contains w
def slice (pre : List Gate) : List ℕ → Finset ℕ
  | [] => ordinarySet pre
  | k::ks =>
    if h : k / 2 < 6 then (pin pre ⟨k / 2, h⟩ (k.testBit 0)).2 ∪ slice pre ks
    else slice pre ks
theorem ordinary_sub (pre : List Gate) : ordinarySet pre ⊆ blocked pre := by
  intro w hw
  obtain ⟨width, how⟩ := Finset.mem_filter.mp hw
  have bound := Finset.mem_range.mp width
  simp only [Bool.and_eq_true, bne_iff_ne, List.any_eq_true, List.contains_iff_mem] at how
  obtain ⟨⟨h3,h4⟩,g,mem,reads⟩ := how
  obtain ⟨i,entry⟩ := List.mem_iff_getElem?.mp mem
  refine Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), Or.inl ?_⟩
  refine ⟨⟨w,bound⟩,rfl,?_, i,(positions_iff _ _ _).mpr ⟨g,entry,reads⟩⟩
  simp [Lower12105.special, Fin.ext_iff, h3, h4]
theorem pin_sub (pre : List Gate) (p : Fin 6) (b : Bool) : (pin pre p b).2 ⊆ blocked pre := by
  intro w hw
  change w ∈ (if cap p b ≤ (saved pre p b).card then forced pre p b else ∅) at hw
  split at hw
  · rename_i paid
    exact Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hw).1, Or.inr ⟨p,b,paid,hw⟩⟩
  · exact False.elim ((Finset.notMem_empty w) hw)
theorem slice_sub (pre : List Gate) (ks : List ℕ) : slice pre ks ⊆ Block12105.blocked pre := by
  induction ks with
  | nil => exact ordinary_sub pre
  | cons k ks ih =>
    simp only [slice]
    split
    · exact Finset.union_subset (pin_sub pre _ _) ih
    · exact ih
end Oracle12105
