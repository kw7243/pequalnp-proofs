    (nc : ∃ x y, target x ≠ target y)
    (size : gs.length ≤ 12) (few : nots gs ≤ 2)
    (p : Nat) (hp : p+1 < gs.length) : keep (gs.take (p+1)) = true := by
  let pre := gs.take (p+1)
  let post := gs.drop (p+1)
  have split : gs = pre ++ post := (List.take_append_drop _ _).symm
  have count : nots pre + nots post ≤ 2 := by rwa [←nots_append, ←split]
  have preSize : pre.length < gs.length := by simpa [pre,List.length_take,Nat.min_eq_left (by omega : p+1 ≤ gs.length)] using hp
  have ho := output_avoids L pre post split preSize
  have safe := suffix_avoids L size pre post split
  have closed (r s : Nat) : rowBad pre (blocked pre) (decide (nots pre = 2)) r s = false := by
    by_contra! bad
    obtain ⟨ht,hf,fit⟩ := rowBad_sound pre (blocked pre) (decide (nots pre = 2)) r s (Bool.eq_true_of_not_eq_false bad)
    by_cases twice : nots pre = 2
    · have none : nots post = 0 := by omega
      have no (g : Gate) (hg : g ∈ post) : g.op ≠ .not := by
        intro h
        have mem : g ∈ post.filter (fun a => !SignedThreshold.isBinary a) := by simp [hg,h,SignedThreshold.isBinary]
        have z : post.filter (fun a => !SignedThreshold.isBinary a) = [] := List.length_eq_zero_iff.mp none
        simp [z] at mem
      have mono (g : Gate) (hg : g ∈ post) : g.op = .and ∨ g.op = .or := by
        have hall := (clean_nok _ _ L.hcl g (split ▸ List.mem_append_right _ hg)).1.1
        rcases hall with h|h|h
        · exact Or.inl h
        · exact Or.inr h
        · exact (no g hg h).elim
      apply order_loss L pre post split _ ho safe mono (row r) (row s) _ ht hf
      simpa [Fits,twice,RowRel] using fit
    · apply eq_loss L pre post split _ ho safe (row r) (row s) _ (by simp [ht,hf])
      simpa [Fits,twice,RowRel] using fit
  change keep pre = true
  unfold keep
  simp only [Bool.and_eq_true,decide_eq_true_eq,Bool.not_eq_true']
  exact ⟨⟨⟨by omega,planeFresh_take_succ L nc p (by omega)⟩,
     least_within L size pre post split⟩, List.any_eq_false.mpr (fun c _ h => by have e := closed c.1 c.2; rw [rowBad,h] at e; contradiction)⟩
theorem no_small_from_empty
    (empty : frontier 6 keep 4 = [])
    (fewOfLeast : ∀ gs o, Least 6 target gs o → gs.length ≤ 12 → nots gs ≤ 2)
    {s : Nat} (h : HasCircuitSize 6 target s) : 13 ≤ s := by
  by_contra! small
  have nc : ∃ x y, target x ≠ target y :=
    ⟨fun _ => false, fun _ => true, by decide +kernel⟩
  obtain ⟨gs,o,L,hs⟩ := exists_least 6 target s nc h
  have candidate : HasCircuitSize 6 target gs.length := by
    have hh := has_of_clean 6 gs o L.hcl
    rwa [show (fun x => vl gs x o) = target from funext L.hev] at hh
  have low := Lower12105.unrestricted_twelve candidate
  have size : gs.length ≤ 12 := by omega
  have few := fewOfLeast gs o L size
  have mem := take_mem_frontier L nc keep 4 (by omega) (by
    intro i pos bound
    obtain ⟨p,rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : i ≠ 0)
    exact keep_least L nc size few p (by omega))
  simp [empty] at mem
end Close12105
