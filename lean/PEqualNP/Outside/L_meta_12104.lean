section SourceOracleCheck
namespace Oracle12105
open PEqualNP.CircuitLowerBounds CircuitHelpers
open SixTable12105 PrefixPlanes12105 Block12105 PrefixEnum12105 Close12105
def slot (n : Nat) (g : Gate) : Nat :=
  match g.op, g.inputs with
  | .not, [a] => a
  | .and, [a,b] | .or, [a,b] =>
    let lo := min a b
    let hi := max a b
    n + 2 * (hi * (hi-1) / 2 + lo) + (match g.op with | .or => 1 | _ => 0)
  | _, _ => 0
def hint (pre : List Gate) : Nat :=
  let dig := pre.foldl (fun (s : Nat × Nat × Nat) (g : Gate) =>
    let idx := slot s.1 g
    (s.1+1,100*s.2.1+idx+1, (bundle s.2.1 >>> (width*idx)) % (2^width))) (6,0,0)
  dig.2.2
def checkOne (pre : List Gate) (code : Nat) : Bool :=
  if code=0 then true
  else if code=1 then decide (nots pre ≤ 2)
  else if code=2 then freshPlanes (planes pre)
  else if code<9 then
    let p : Fin 6 := ⟨(code-3)%6, Nat.mod_lt _ (by decide)⟩
    Lower12105.special p || decide ((positions pre p.val).card ≤ 1)
  else if code<21 then
    let k := code-9
    let p : Fin 6 := ⟨(k/2)%6, Nat.mod_lt _ (by decide)⟩
    decide ((Prefix12105.saved pre p (k.testBit 0)).card ≤ cap p (k.testBit 0))
  else
    let act := catalog.getD (code-21) (0,[])
    match clues[act.1]? with
    | none => true
    | some (r,s) => !rowBad pre (slice pre act.2) (decide (nots pre=2)) r s
def oracleKeep (pre : List Gate) : Bool := checkOne pre (hint pre)
theorem rowBad_mono (vals : List (BitVec 64)) {a b : Finset Nat} (sub : a ⊆ b)
    (ordered : Bool) (r s : Nat) (h : rowBadPlanes vals a ordered r s = true) :
    rowBadPlanes vals b ordered r s = true := by
  simp only [rowBadPlanes,Bool.and_eq_true,List.all_eq_true,Bool.or_eq_true,
    decide_eq_true_eq] at h ⊢
  refine ⟨h.1,fun i hi => ?_⟩
  exact (h.2 i hi).imp (fun ha => sub ha) id
theorem useful (pre : List Gate) (code : Nat) (yes : keep pre = true) : checkOne pre code = true := by
  simp only [keep,Bool.and_eq_true,decide_eq_true_eq,Bool.not_eq_true'] at yes
  obtain ⟨⟨⟨few,fresh⟩,regular⟩,noRows⟩ := yes
  unfold checkOne
  split
  · rfl
  split
  · simpa using few
  split
  · exact fresh
  split
  · dsimp only
    rw [Bool.or_eq_true]
    by_cases sp : Lower12105.special ⟨(code-3)%6, Nat.mod_lt _ (by decide)⟩ = true
    · exact Or.inl sp
    · exact Or.inr (decide_eq_true (regular.2 _ (Bool.eq_false_iff.mpr sp)))
  split
  · exact decide_eq_true (regular.1 _ _)
  · dsimp only
    split
    · rfl
    next r s entry =>
      rw [Bool.not_eq_true']
      apply Bool.eq_false_iff.mpr
      intro bad
      have inList : (r,s) ∈ clues := List.mem_of_getElem? entry
      have bigger := rowBad_mono (planes pre) (slice_sub pre _) _ r s bad
      have failure := List.any_eq_false.mp noRows (r,s) inList
      exact failure bigger
theorem small_from_oracle (closed : frontier 6 oracleKeep 4 = [])
    {gs : List Gate} {o : Nat} (L : Readers.Least 6 target gs o) (full : gs.length = 12)
    (nc : ∃ x y, target x ≠ target y) (few : nots gs ≤ 2) : False := by
  have mem := take_mem_frontier L nc oracleKeep 4 (by omega) (by
    intro i pos lim
    obtain ⟨p,rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : i ≠ 0)
    exact useful _ _ (keep_least L nc (by omega) few p (by omega)))
  simp [closed] at mem
end Oracle12105
end SourceOracleCheck

