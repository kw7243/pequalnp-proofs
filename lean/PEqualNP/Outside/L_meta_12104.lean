private def rename (p : Fin 6) (b : Bool) : Fin 6 → Fin 5 :=
  match p.val,b with
  | 0,false => ![0,0,1,2,3,4]
  | 0,true => ![0,2,3,0,1,4]
  | 1,false => ![0,0,1,2,3,4]
  | 1,true => ![2,0,3,0,1,4]
  | 2,false => ![0,1,0,2,3,4]
  | 2,true => ![2,3,0,0,1,4]
  | 3,false => ![1,2,3,0,0,4]
  | 3,true => ![0,1,2,0,3,4]
  | 4,false => ![1,2,3,0,0,4]
  | 4,true => ![0,1,2,3,0,4]
  | _,false => ![0,1,2,3,4,0]
  | _,true => ![2,3,4,0,1,0]
theorem no_funnel : NoFunnel target := by
  have check : ∀ p q : Fin 6, p ≠ q → ¬PairFunnel target p q := by
    unfold PairFunnel
    decide +kernel
  exact fun p q hp _ _ => check p q hp
theorem restrictions_nonconstant : RestrNC target := by
  have check : ∀ p : Fin 6, ∀ b : Bool, ∃ x y : Fin 6 → Bool,
      target (Function.update x p b) ≠ target (Function.update y p b) := by
    decide +kernel
  exact fun p _ => check p
theorem lower_cofactor
    (A0 : ∀ s, HasCircuitSize 5 (table5 0xe8808000) s → 9 ≤ s)
    (A1 : ∀ s, HasCircuitSize 5 (table5 0xeee8e880) s → 10 ≤ s)
    (B0 : ∀ s, HasCircuitSize 5 (table5 0xa8808000) s → 8 ≤ s)
    (B1 : ∀ s, HasCircuitSize 5 (table5 0xfee8e880) s → 10 ≤ s)
    (p : Fin 6) (b : Bool) {s : ℕ}
    (h : HasCircuitSize 6 (fun x => target (Function.update x p b)) s) :
    (if b then 10 else if special p then 8 else 9) ≤ s := by
  have eq : ∀ j : Fin 6, ∀ c : Bool, ∀ x : Fin 5 → Bool,
      target (Function.update (x ∘ rename j c) j c) = table5 (lowerMask j c) x := by
    decide +kernel
  have remapped := PermInputs.relabel_size (rename p b) _ s h
  obtain ⟨C,shape,cost,eval⟩ := remapped
  have hmask : HasCircuitSize 5 (table5 (lowerMask p b)) s :=
    ⟨C,shape,cost,fun x => (eval x).trans (eq p b x)⟩
  cases sp : special p <;> cases b <;> simp [lowerMask,sp] at hmask ⊢
  · exact A0 s hmask
  · exact A1 s hmask
  · exact B0 s hmask
  · exact B1 s hmask
theorem lower12_from_cases
    (A0 : ∀ s, HasCircuitSize 5 (table5 0xe8808000) s → 9 ≤ s)
    (A1 : ∀ s, HasCircuitSize 5 (table5 0xeee8e880) s → 10 ≤ s)
    (B0 : ∀ s, HasCircuitSize 5 (table5 0xa8808000) s → 8 ≤ s)
    (B1 : ∀ s, HasCircuitSize 5 (table5 0xfee8e880) s → 10 ≤ s)
    {s : ℕ} (h : HasCircuitSize 6 target s) : 12 ≤ s := by
  have hd : ∃ (p : Fin 6), Dep target p := by unfold Dep; decide +kernel
  obtain ⟨p,_,budget⟩ := fanout_step 5 target s hd restrictions_nonconstant no_funnel h
  have false_cost (j : ℕ) (drop : Drop target p false j s) :
      (if special p then 8 else 9) + j ≤ s := by
    obtain ⟨s',cost,circ⟩ := drop
    have lb := lower_cofactor A0 A1 B0 B1 p false circ
    simp only [Bool.false_eq_true,ite_false] at lb
    omega
  have true_cost (j : ℕ) (drop : Drop target p true j s) : 10+j ≤ s := by
    obtain ⟨s',cost,circ⟩ := drop
    have lb := lower_cofactor A0 A1 B0 B1 p true circ
    simp only [ite_true] at lb
    omega
  rcases budget with hh|hh|hh
  · have bound := true_cost 3 hh.2; omega
  · exact true_cost 2 hh.2
  · have bound := true_cost 4 hh.2; omega
