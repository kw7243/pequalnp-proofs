section SourcePrefixSound
namespace Prefix12105
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity CircuitHelpers
open CircuitHelpers.Readers
abbrev view {n : ℕ} (pre : List Gate) (x : Fin n → Bool) (i : ℕ) : Bool := vl pre x i
def Fits {n : ℕ} (R : Bool → Bool → Prop) (pre : List Gate) (blocked : Finset ℕ)
    (x y : Fin n → Bool) : Prop :=
  ∀ i : Fin (n+pre.length), i.val ∉ blocked → R (view pre x i.val) (view pre y i.val)
private theorem getD_append_last (xs : List Bool) (b : Bool) (i : ℕ) :
    (xs ++ [b]).getD i false =
      if i < xs.length then xs.getD i false else if i = xs.length then b else false := by
  split
  · exact List.getD_append _ _ _ _ ‹_›
  · rw [List.getD_append_right _ _ _ _ (by omega)]
    split
    · simp [‹i=xs.length›,List.getD_eq_getElem?_getD]
    · exact List.getD_eq_default _ _ (by simp; omega)
private theorem propagate (R : Bool → Bool → Prop) (reflFalse : R false false) (blocked : Finset ℕ)
    (gs : List Gate) (safe : ∀ g ∈ gs, ∀ i ∈ g.inputs, i ∉ blocked)
    (preserves : ∀ g ∈ gs, ∀ X Y : ℕ → Bool, (∀ i ∈ g.inputs, R (X i) (Y i)) →
      R (g.op.eval (g.inputs.map X)) (g.op.eval (g.inputs.map Y)))
    {w z : List Bool} (len : w.length = z.length)
    (start : ∀ i, i ∉ blocked → R (w.getD i false) (z.getD i false)) :
    ∀ i, i ∉ blocked → R ((wiresFrom gs w).getD i false) ((wiresFrom gs z).getD i false) := by
  induction gs generalizing w z with
  | nil => exact start
  | cons g gs ih =>
    apply ih (fun k hk => safe k (by simp [hk])) (fun k hk => preserves k (by simp [hk]))
    · simp [len]
    · intro i free
      rw [getD_append_last,getD_append_last,len]
      split
      · exact start i free
      · split
        · exact preserves g (by simp) _ _ (fun j hj => start j (safe g (by simp) j hj))
        · exact reflFalse
private theorem extend_cut {n : ℕ} {pre post : List Gate} {R : Bool → Bool → Prop} (rf : R false false)
    (S : Finset ℕ) (safe : ∀ g ∈ post, ∀ i ∈ g.inputs, i ∉ S)
    (ops : ∀ g ∈ post, ∀ X Y : ℕ → Bool, (∀ i ∈ g.inputs, R (X i) (Y i)) →
      R (g.op.eval (g.inputs.map X)) (g.op.eval (g.inputs.map Y)))
    (o : ℕ) (ho : o ∉ S) (x y : Fin n → Bool) (rows : Fits R pre S x y) :
    R (vl (pre++post) x o) (vl (pre++post) y o) := by
  unfold vl
  rw [wiresFrom_append,wiresFrom_append]
  apply propagate R rf S post safe ops (by simp [length_wiresFrom]) _ o ho
  intro i free
  by_cases small : i < n+pre.length
  · exact rows ⟨i,small⟩ free
  · rw [List.getD_eq_default _ _ (by simp [length_wiresFrom]; omega),
        List.getD_eq_default _ _ (by simp [length_wiresFrom]; omega)]
    exact rf
theorem eq_loss {n : ℕ} {f : (Fin n → Bool) → Bool} {gs : List Gate} {o : ℕ}
    (L : Least n f gs o) (pre post : List Gate) (split : gs = pre++post)
    (blocked : Finset ℕ) (ho : o ∉ blocked)
    (safe : ∀ g ∈ post, ∀ i ∈ g.inputs, i ∉ blocked)
    (x y : Fin n → Bool) (rows : Fits Eq pre blocked x y) (wrong : f x ≠ f y) : False := by
  apply wrong
  rw [← L.hev x, ← L.hev y, split]
  apply extend_cut (R:=Eq) rfl blocked safe _ o ho x y rows
  intro g _ X Y same
  rw [List.map_congr_left same]
theorem order_loss {n : ℕ} {f : (Fin n → Bool) → Bool} {gs : List Gate} {o : ℕ}
    (L : Least n f gs o) (pre post : List Gate) (split : gs = pre++post)
    (blocked : Finset ℕ) (ho : o ∉ blocked)
    (safe : ∀ g ∈ post, ∀ i ∈ g.inputs, i ∉ blocked)
    (mono : ∀ g ∈ post, g.op = .and ∨ g.op = .or)
    (x y : Fin n → Bool) (rows : Fits (· ≤ ·) pre blocked x y)
    (hx : f x = true) (hy : f y = false) : False := by
  have bad : f x ≤ f y := by
    rw [← L.hev x, ← L.hev y, split]
    apply extend_cut (R:=(· ≤ ·)) le_rfl blocked safe _ o ho x y rows
    intro g hg X Y h
    apply Bool.le_iff_imp.mpr
    rcases mono g hg with op|op
    · simp [op,GateOp.eval]
      intro H i hi
      exact Bool.le_iff_imp.mp (h i hi) (H i hi)
    · intro hX
      have hx' : ∃ i ∈ g.inputs, X i = true := by simpa [op,GateOp.eval] using hX
      obtain ⟨i,hi,xi⟩ := hx'
      have hy' : ∃ i ∈ g.inputs, Y i = true := ⟨i,hi,Bool.le_iff_imp.mp (h i hi) xi⟩
      simpa [op,GateOp.eval] using hy'
  rw [hx,hy] at bad
  exact Bool.noConfusion (Bool.le_iff_imp.mp bad rfl)
theorem output_after_prefix {n : ℕ} {f : (Fin n → Bool) → Bool} {gs : List Gate} {o : ℕ}
    (L : Least n f gs o) (pre post : List Gate) (split : gs = pre++post)
    (later : pre.length < gs.length) : n+pre.length ≤ o := by
  by_contra! prefixOnly
  have smaller : CleanL n pre := by
    intro i g h
    have hi : i < pre.length := (List.getElem?_eq_some_iff.1 h).1
    apply L.hcl i g
    rwa [split,List.getElem?_append_left hi]
  have same (x : Fin n → Bool) : vl pre x o = f x := by
    rw [← L.hev x,split]
    unfold vl
    rw [wiresFrom_append, getD_wiresFrom post (wiresFrom pre (List.ofFn x)) o (by simpa [length_wiresFrom] using prefixOnly)]
  exact (Nat.not_le_of_gt later) (L.hmin pre o smaller same)
end Prefix12105
end SourcePrefixSound

section SourceEnum
namespace PrefixEnum12105
open PEqualNP.CircuitLowerBounds CircuitHelpers CircuitHelpers.Readers
def choices (width : ℕ) : List Gate :=
  (List.range width).flatMap fun a =>
    (⟨.not, [a]⟩ : Gate) ::
      ((List.range width).flatMap fun b =>
        if a = b then [] else [⟨.and, [a,b]⟩, ⟨.or, [a,b]⟩])
theorem mem_choices {n : ℕ} {f : (Fin n → Bool) → Bool} {gs : List Gate} {o p : ℕ}
    (L : Least n f gs o) (nc : ∃ x y, f x ≠ f y) {g : Gate}
    (entry : gs[p]? = some g) : g ∈ choices (n+p) := by
  obtain ⟨op,pins⟩ := g
  obtain ⟨hop,a,ha,hpins⟩ | ⟨hop,a,b,ha,hb,hpins⟩ := L.hcl p _ entry
  · change op = .not at hop
    change pins = [a] at hpins
    subst op; subst pins
    exact List.mem_flatMap.mpr ⟨a, List.mem_range.mpr ha, List.mem_cons_self⟩
  · change op = .and ∨ op = .or at hop
    change pins = [a,b] at hpins
    subst pins
    have distinct : a ≠ b := by
      rintro rfl
      apply L.no_alias nc p (List.getElem?_eq_some_iff.mp entry).1 a ha
      intro x
      rw [vl_gate gs L.hcl x p _ entry]
      rcases hop with rfl | rfl <;> simp [GateOp.eval]
    apply List.mem_flatMap.mpr
    refine ⟨a, List.mem_range.mpr ha, List.mem_cons_of_mem _ ?_⟩
    apply List.mem_flatMap.mpr
    refine ⟨b,List.mem_range.mpr hb,?_⟩
    rw [ite_eq_right distinct]
    rcases hop with rfl | rfl
    · exact List.mem_cons_self
    · exact List.mem_cons_of_mem _ List.mem_cons_self
def frontier (n : ℕ) (keep : List Gate → Bool) : ℕ → List (List Gate)
  | 0 => [[]]
  | d+1 => (frontier n keep d).flatMap fun pre =>
      (((choices (n+d)).map fun g => pre ++ [g]).filter keep)
theorem take_mem_frontier {n : ℕ} {f : (Fin n → Bool) → Bool} {gs : List Gate} {o : ℕ}
    (L : Least n f gs o) (nc : ∃ x y, f x ≠ f y)
    (keep : List Gate → Bool) (d : ℕ) (hd : d ≤ gs.length)
    (accepted : ∀ i, 0 < i → i ≤ d → keep (gs.take i) = true) :
    gs.take d ∈ frontier n keep d := by
  induction d with
  | zero => simp [frontier]
  | succ d ih =>
    have step : d < gs.length := by omega
    apply List.mem_flatMap.mpr
    refine ⟨gs.take d, ih (by omega) (fun i hi hj => accepted i hi (by omega)), ?_⟩
    apply List.mem_filter.mpr
    refine ⟨List.mem_map.mpr ⟨gs[d], mem_choices L nc (by simp [step]),?_⟩,
      accepted _ (by omega) (by omega)⟩
    exact (List.take_succ_eq_append_getElem step).symm
theorem value_take {n : ℕ} (gs : List Gate) (x : Fin n → Bool) (d i : ℕ)
    (hd : d ≤ gs.length) (hi : i < n+d) :
    vl (gs.take d) x i = vl gs x i := by
  unfold vl
  conv_rhs => rw [←List.take_append_drop d gs, wiresFrom_append]
  apply Eq.symm
  apply getD_wiresFrom
  simpa [length_wiresFrom, List.length_take, Nat.min_eq_left hd] using hi
theorem prefix_fresh {n : ℕ} {f : (Fin n → Bool) → Bool} {gs : List Gate} {o : ℕ}
    (L : Least n f gs o) (nc : ∃ x y, f x ≠ f y) (p : ℕ) (hp : p < gs.length) :
    (∀ bit : Bool, ¬ ∀ x : Fin n → Bool, vl (gs.take (p+1)) x (n+p) = bit) ∧
    (∀ j < n+p, ¬ ∀ x : Fin n → Bool, vl (gs.take (p+1)) x (n+p) = vl (gs.take (p+1)) x j) := by
  have eqn (x : Fin n → Bool) (j : ℕ) (h : j ≤ n+p) :=
    value_take gs x (p+1) j (by omega) (by omega : j < n+(p+1))
  constructor
  · intro b same
    apply L.no_const nc p hp b
    intro x
    exact (eqn x _ (le_refl _)).symm.trans (same x)
  · intro j hj same
    apply L.no_alias nc p hp j hj
    intro x
    exact (eqn x _ (le_refl _)).symm.trans ((same x).trans (eqn x _ (by omega)))
def fresh (n : ℕ) (pre : List Gate) : Bool :=
  match pre.length with
  | 0 => true
  | p+1 => decide (
      (∀ bit : Bool, ¬ ∀ x : Fin n → Bool, vl pre x (n+p) = bit) ∧
      (∀ j : Fin (n+p), ¬ ∀ x : Fin n → Bool, vl pre x (n+p) = vl pre x j.val))
end PrefixEnum12105
end SourceEnum

section SourcePlanes
namespace PrefixPlanes12105
open PEqualNP.CircuitLowerBounds CircuitHelpers Prefix12105 SixTable12105
def row (r : ℕ) (i : Fin 6) : Bool := r.testBit i.val
def inputs : List (BitVec 64) :=
  [0xaaaaaaaaaaaaaaaa,0xcccccccccccccccc,0xf0f0f0f0f0f0f0f0,
   0xff00ff00ff00ff00,0xffff0000ffff0000,0xffffffff00000000]
def mask (f : Fin 64 → Bool) : BitVec 64 :=
  (BitVec.ofBoolListLE (List.ofFn f)).cast (by simp)
theorem mask_bit (f : Fin 64 → Bool) (r : Fin 64) :
    (mask f).getLsbD r = f r := by
  rw [mask, BitVec.getLsbD_cast, BitVec.getLsbD_ofBoolListLE]
  exact getD_ofFn 64 f false r
def process (op : GateOp) (vs : List (BitVec 64)) : BitVec 64 :=
  match op, vs with
  | .and, [a,b] => a &&& b
  | .or, [a,b] => a ||| b
  | .not, [a] => ~~~a
  | op, vs => mask fun r => op.eval (vs.map fun v => v.getLsbD r)
theorem process_bit (op : GateOp) (vs : List (BitVec 64)) (r : Fin 64) :
    (process op vs).getLsbD r = op.eval (vs.map fun v => v.getLsbD r) := by
  unfold process
  split
  · rw [BitVec.getLsbD_and]
    simp only [List.map_cons,List.map_nil,GateOp.eval,List.all_cons,List.all_nil,id_eq,Bool.and_true]
  · rw [BitVec.getLsbD_or]
    simp only [List.map_cons,List.map_nil,GateOp.eval,List.any_cons,List.any_nil,id_eq,Bool.or_false]
  · rw [BitVec.getLsbD_not,decide_eq_true r.isLt]; rfl
  · exact mask_bit _ _
def step (ps : List (BitVec 64)) (g : Gate) : List (BitVec 64) :=
  ps ++ [process g.op (g.inputs.map fun j => ps.getD j 0)]
def planes (pre : List Gate) : List (BitVec 64) := pre.foldl step inputs
theorem inputs_row : ∀ r : Fin 64, inputs.map (fun v => v.getLsbD r) = List.ofFn (row r) := by
  decide +kernel
theorem mapbit_getD (ps : List (BitVec 64)) (r j : ℕ) :
    (ps.getD j 0).getLsbD r = (ps.map fun v => v.getLsbD r).getD j false := by
  simp only [List.getD_eq_getElem?_getD, List.getElem?_map]
  cases ps[j]? <;> simp
theorem planes_row (pre : List Gate) (r : Fin 64) :
    (planes pre).map (fun v => v.getLsbD r) = wiresFrom pre (List.ofFn (row r)) := by
  have fold (gs : List Gate) (ps : List (BitVec 64)) :
      (gs.foldl step ps).map (fun v => v.getLsbD r) =
        wiresFrom gs (ps.map fun v => v.getLsbD r) := by
    induction gs generalizing ps with
    | nil => rfl
    | cons g gs ih =>
      simp only [List.foldl_cons, ih]
      change wiresFrom gs ((step ps g).map _) = wiresFrom gs _
      congr 1
      simp only [step, List.map_append, List.map_cons, List.map_nil, process_bit,
        List.map_map, Function.comp_def, mapbit_getD]
  rw [planes, fold, inputs_row]
theorem planes_bit (pre : List Gate) (r : Fin 64) (j : ℕ) :
    ((planes pre).getD j 0).getLsbD r = vl pre (row r) j := by
  rw [mapbit_getD, planes_row]
  rfl
def targetMask : BitVec 64 := 0xfee8e800e8808000
theorem target_bit : ∀ r : Fin 64, targetMask.getLsbD r.val = target (row r.val) := by
  decide +kernel
def RowRel (ordered : Bool) (a b : Bool) : Prop := if ordered then a ≤ b else a = b
def rowBadPlanes (vals : List (BitVec 64)) (blocked : Finset ℕ) (ordered : Bool) (r s : ℕ) : Bool :=
  r < 64 && s < 64 && targetMask.getLsbD r && !(targetMask.getLsbD s) &&
    (List.range vals.length).all fun i =>
      let v := vals.getD i 0
      decide (i ∈ blocked) || (if ordered then !(v.getLsbD r) || v.getLsbD s
                               else v.getLsbD r == v.getLsbD s)
def rowBad (pre : List Gate) (blocked : Finset ℕ) (ordered : Bool) (r s : ℕ) : Bool :=
  rowBadPlanes (planes pre) blocked ordered r s
theorem length_planes (pre : List Gate) : (planes pre).length = 6+pre.length := by
  have e := congrArg List.length (planes_row pre (0 : Fin 64))
  simpa only [List.length_map, length_wiresFrom, List.length_ofFn] using e
theorem rowBad_sound (pre : List Gate) (blocked : Finset ℕ) (ordered : Bool) (r s : ℕ)
    (ok : rowBad pre blocked ordered r s = true) :
    target (row r) = true ∧ target (row s) = false ∧ Fits (RowRel ordered) pre blocked (row r) (row s) := by
  simp only [rowBad, rowBadPlanes, length_planes, Bool.and_eq_true, decide_eq_true_eq, Bool.not_eq_true', List.all_eq_true] at ok
  obtain ⟨⟨⟨⟨hr,hs⟩,tr⟩,ts⟩,each⟩ := ok
  have rp : targetMask.getLsbD r = target (row r) := target_bit ⟨r,hr⟩
  have sp : targetMask.getLsbD s = target (row s) := target_bit ⟨s,hs⟩
  refine ⟨rp.symm.trans tr, sp.symm.trans ts, ?_⟩
  intro i free
  have h := each i.val (List.mem_range.mpr i.isLt)
  have rv : ((planes pre).getD i.val 0).getLsbD r = vl pre (row r) i.val := planes_bit pre ⟨r,hr⟩ i.val
  have sv : ((planes pre).getD i.val 0).getLsbD s = vl pre (row s) i.val := planes_bit pre ⟨s,hs⟩ i.val
  simp only [decide_eq_false free, Bool.false_or,rv,sv] at h
  cases ordered
  · simpa [RowRel] using h
  · apply Bool.le_iff_imp.mpr
    intro hx
    simpa [hx] using h
def freshPlanes (vals : List (BitVec 64)) : Bool :=
  let i := vals.length-1
  let v := vals.getD i 0
  v != 0 && v != BitVec.allOnes 64 && (List.range i).all fun j => v != vals.getD j 0
def planeFresh (pre : List Gate) : Bool := freshPlanes (planes pre)
theorem row_surj : ∀ x : Fin 6 → Bool, ∃ r : Fin 64, row r = x := by decide +kernel
theorem planeFresh_take_succ {f : (Fin 6 → Bool) → Bool} {gs : List Gate} {o : ℕ}
    (L : Readers.Least 6 f gs o) (nc : ∃ x y, f x ≠ f y) (p : ℕ) (hp : p < gs.length) :
    planeFresh (gs.take (p+1)) = true := by
  obtain ⟨nonconst, noalias⟩ := PrefixEnum12105.prefix_fresh L nc p hp
  let pre := gs.take (p+1)
  have len : (planes pre).length - 1 = 6+p := by
    rw [length_planes]
    simp [pre, List.length_take, Nat.min_eq_left hp]
  change freshPlanes (planes pre) = true
  simp only [freshPlanes, len, Bool.and_eq_true, bne_iff_ne, List.all_eq_true, List.mem_range]
  constructor
  · constructor
    · intro z
      apply nonconst false
      intro x
      obtain ⟨r,rfl⟩ := row_surj x
      rw [← planes_bit pre, z]
      exact BitVec.getLsbD_zero
    · intro z
      apply nonconst true
      intro x
      obtain ⟨r,rfl⟩ := row_surj x
      rw [← planes_bit pre, z, BitVec.getLsbD_allOnes, decide_eq_true r.isLt]
  · intro j hj z
    apply noalias j hj
    intro x
    obtain ⟨r,rfl⟩ := row_surj x
    rw [← planes_bit pre, ← planes_bit pre, z]
end PrefixPlanes12105
end SourcePlanes

section SourcePrefixPin
namespace Prefix12105
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity CircuitHelpers
open CircuitHelpers.Readers
def isConst : Stat → Bool
  | .const _ => true
  | .wire _ => false
def forced {n : ℕ} (pre : List Gate) (i : Fin (n+1)) (b : Bool) : Finset ℕ :=
  (Finset.range (n+1+pre.length)).filter (fun w => isConst (stF n pre i b w))
def saved {n : ℕ} (pre : List Gate) (i : Fin (n+1)) (b : Bool) : Finset ℕ :=
  (Finset.range pre.length).filter (fun p =>
    (pre[p]?).any (fun g => g.inputs.any (fun w => w ∈ forced pre i b)))
theorem forced_sound {n : ℕ} (pre post : List Gate) (i : Fin (n+1)) (b : Bool) {w : ℕ}
    (mem : w ∈ forced pre i b) : IsC n (pre++post) i b w := by
  have pair := Finset.mem_filter.mp mem
  have less := Finset.mem_range.mp pair.1
  have agree : stF n (pre++post) i b w = stF n pre i b w := by
    rw [stF,elim_append]
    exact elim_getD _ _ _ _ _ (by simpa [elim_fst_len,statAt_length] using less)
  unfold IsC
  rw [agree]
  cases eq : stF n pre i b w with
  | const c => exact ⟨c,rfl⟩
  | wire j => simp [eq,isConst] at pair
theorem saved_sound {n : ℕ} (pre post : List Gate) (i : Fin (n+1)) (b : Bool) {k : ℕ}
    (mem : k ∈ saved pre i b) : RC n (pre++post) i b k := by
  have pair := Finset.mem_filter.mp mem
  have less := Finset.mem_range.mp pair.1
  have gt : pre[k]? = some pre[k] := List.getElem?_eq_getElem less
  have yes := pair.2
  simp only [gt,Option.any_some,List.any_eq_true,decide_eq_true_eq] at yes
  obtain ⟨w,read,forcedWire⟩ := yes
  apply rc_of_reads _ (forced_sound pre post i b forcedWire)
  refine ⟨pre[k],?_,read⟩
  rwa [List.getElem?_append_left less]
theorem prefix_savings_bound {n : ℕ} {f : (Fin (n+1) → Bool) → Bool} {gs : List Gate} {o : ℕ}
    (L : Least (n+1) f gs o) (pre post : List Gate) (split : gs=pre++post)
    (i : Fin (n+1)) (b : Bool)
    (nc : ∃ x y, f (Function.update x i b) ≠ f (Function.update y i b))
    (cap : ℕ) (limit : ∀ k, Drop f i b k gs.length → k ≤ cap) :
    (saved pre i b).card ≤ cap := by
  apply limit
  apply L.save i b nc
  intro a ha
  rw [split]
  exact saved_sound pre post i b ha
theorem saturated_no_read {n : ℕ} {f : (Fin (n+1) → Bool) → Bool} {gs : List Gate} {o : ℕ}
    (L : Least (n+1) f gs o) (pre post : List Gate) (split : gs=pre++post)
    (i : Fin (n+1)) (b : Bool)
    (nc : ∃ x y, f (Function.update x i b) ≠ f (Function.update y i b))
    (cap : ℕ) (limit : ∀ k, Drop f i b k gs.length → k ≤ cap)
    (full : cap ≤ (saved pre i b).card)
    (w : ℕ) (pin : w ∈ forced pre i b)
    (q : ℕ) (later : pre.length ≤ q) : ¬Reads gs q w := by
  intro reader
  have fresh : q ∉ saved pre i b := fun h =>
    (Nat.not_lt_of_ge later) (Finset.mem_range.mp (Finset.mem_filter.mp h).1)
  have budget := L.save i b nc (insert q (saved pre i b)) (by
    intro a ha
    rcases Finset.mem_insert.mp ha with rfl|mem
    · apply rc_of_reads reader
      rw [split]
      exact forced_sound pre post i b pin
    · rw [split]
      exact saved_sound pre post i b mem)
  have excess := limit _ budget
  rw [Finset.card_insert_of_notMem fresh] at excess
  omega
theorem tail_reader (pre post : List Gate) {g : Gate} (mem : g ∈ post)
    {w : ℕ} (read : w ∈ g.inputs) : ∃ q, pre.length ≤ q ∧ Reads (pre++post) q w := by
  obtain ⟨j,hj,eq⟩ := List.getElem_of_mem mem
  refine ⟨pre.length+j,by omega,g,?_,read⟩
  rw [List.getElem?_append_right (by omega)]
  simpa [eq] using List.getElem?_eq_getElem hj
end Prefix12105
