section SourceBranch
namespace Lower12105
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity
open CircuitHelpers
open CircuitHelpers.Readers
open SixTable12105
def table5 (t : ℕ) (x : Fin 5 → Bool) : Bool :=
  Nat.testBit t (∑ i : Fin 5, if x i then 2^(i:ℕ) else 0)
def special (p : Fin 6) : Bool := decide (p=3 ∨ p=4)
private def lowerMask (p : Fin 6) (b : Bool) : ℕ :=
