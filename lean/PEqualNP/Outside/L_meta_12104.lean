abbrev Result := Bool × Finset ℕ
def pin (pre : List Gate) (p : Fin 6) (b : Bool) : Result :=
  let status := (elim 5 pre (statAt 5 p b, [])).1
  let fixed := (Finset.range (6 + pre.length)).filter fun w => isConst (status.getD w (.const false))
  let paid := ((Finset.range pre.length).filter fun k =>
    (pre[k]?).any fun g => g.inputs.any fun w => w ∈ fixed).card
  let budget := cap p b
  (decide (paid ≤ budget), if budget ≤ paid then fixed else ∅)
def ordinary (pre : List Gate) (p : Fin 6) : Result :=
  if Lower12105.special p then (true,∅) else
    let uses := (positions pre p.val).card
    (decide (uses ≤ 1), if 0 < uses then {p.val} else ∅)
end FastBlock12105
